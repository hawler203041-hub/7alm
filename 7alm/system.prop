persist.sys.use_fifo_ui=1

ro.surface_flinger.set_touch_timer_ms=10
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_choreographer_force_full_ms=1
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.enable_frame_timing_offsets_as_constraints=true
ro.surface_flinger.display_smooth_level=3

debug.hwui.show_dirty_regions=false
debug.hwui.disable_scissor_opt=true
debug.hwui.renderer_opaque_bg_for_rounded_corners_disabled=true
debug.hwui.use_gpu_backend_thread_pool=true
debug.hwui.thread_pool_min_count=5
debug.hwui.thread_pool_max_count=8

persist.sys.splash_screen_exit_on_move=1
persist.sys.splash_screen_background_dark=true

dalvik.vm.heapsize=256m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=8m
dalvik.vm.heapmaxfree=32m

ro.config.hw_fast_dormancy=1
persist.sys.scrollingcache=32/70
